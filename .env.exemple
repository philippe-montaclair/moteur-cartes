# Correction assistée par LLM — copier en « .env » et adapter.
# Le fichier .env n'écrase jamais une variable déjà définie dans le shell.

# ---------------------------------------------------------------------------
# Moteur : ollama | lmstudio | distant | off
# ---------------------------------------------------------------------------
LLM_BACKEND=ollama

# --- Ollama (défaut) -------------------------------------------------------
# Rien d'autre à renseigner. Vérifier qu'il tourne :  ollama serve
# Modèle laissé vide = le premier que le moteur propose.
# LLM_MODELE=llama3.1:8b

# --- LM Studio -------------------------------------------------------------
# LLM_BACKEND=lmstudio
# (démarrer le serveur local dans LM Studio, onglet « Developer »)

# --- API distante ----------------------------------------------------------
# LLM_BACKEND=distant
# LLM_URL=https://api.exemple.com/v1
# LLM_CLE=sk-...
# LLM_MODELE=...

# ---------------------------------------------------------------------------
# Les trois rôles — et la règle qui les sépare
# ---------------------------------------------------------------------------
#
# « correcteur » sert l'apprenant en ligne : il doit être rapide.
# « redacteur »  écrit les cartes hors ligne : il doit être bon.
# « juge »       les met à l'épreuve sans jamais voir la réponse attendue.
#
# RÈGLE : aucun modèle ne valide sa propre production. La fabrique refuse de
# travailler si le rédacteur et le juge sont le même modèle, ou si l'un des
# deux n'est pas NOMMÉ — sans nom, le moteur prend le premier modèle que
# l'hôte propose, donc le même pour les deux, et la séparation serait vraie
# sur le papier et fausse à l'exécution.
#
# Chaque rôle lit d'abord sa variable suffixée, puis retombe sur la commune.
# Un poste qui n'a qu'un seul modèle continue donc de corriger normalement ;
# seule la fabrique exige les deux.
#
# Un juge PLUS FAIBLE que le rédacteur convient très bien : on ne lui demande
# pas d'avoir raison, on lui demande d'être un autre esprit et d'être
# reproductible ou pas. C'est la divergence de ses réponses qui est le signal.
#
# LLM_MODELE_REDACTEUR=...
# LLM_MODELE_JUGE=...
# LLM_BACKEND_JUGE=ollama      (facultatif : un juge local, un rédacteur distant)
# LLM_URL_JUGE=...
# LLM_CLE_JUGE=...
# LLM_TIMEOUT_JUGE=120

# ---------------------------------------------------------------------------
# Réglages communs
# ---------------------------------------------------------------------------

# Types de carte confiés au LLM. Le code et les mots-clés se corrigent très
# bien sans lui : les y envoyer coûterait du temps pour rien.
LLM_TYPES=texte

# Délai maximal, en secondes. Un modèle 7B sur processeur met 5 à 20 s.
LLM_TIMEOUT=45
